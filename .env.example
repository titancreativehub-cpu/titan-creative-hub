# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000

# Firebase Client SDK Configuration (Required for Authentication, Firestore, and Storage)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Admin SDK Configuration (Required on Backend for RBAC, Payment Fulfillment, and Protected Downloads)
# Paste the single-line JSON string of your Firebase Service Account key
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Optional: Comma-separated verified admin emails as bootstrap allowlist
ADMIN_EMAILS=""

# Paystack Payment Gateway (Backend Secret Only - Keep in Test Mode sk_test_... until live)
PAYSTACK_SECRET_KEY=""

# Gmail SMTP Notification Service (Backend Secret Only - Used to notify titancreativehub@gmail.com and customers)
GMAIL_USER="titancreativehub@gmail.com"
GMAIL_APP_PASSWORD=""
