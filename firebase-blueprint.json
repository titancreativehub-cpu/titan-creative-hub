{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered student or administrator account.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "suspended": { "type": "boolean" },
        "phone": { "type": "string", "maxLength": 32 },
        "bio": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "role", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Digital video course offered in NGN.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "description": { "type": "string", "maxLength": 5000 },
        "instructorName": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 64 },
        "priceNGN": { "type": "number" },
        "duration": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "lessonsCount": { "type": "number" },
        "published": { "type": "boolean" },
        "thumbnailUrl": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "title", "instructorName", "category", "priceNGN", "level", "published"]
    },
    "Module": {
      "title": "Module",
      "description": "Curriculum section inside a course.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "courseId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 180 },
        "order": { "type": "number" }
      },
      "required": ["id", "courseId", "title", "order"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Individual video lesson and downloadable resource reference.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "courseId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "moduleId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 180 },
        "description": { "type": "string", "maxLength": 3000 },
        "duration": { "type": "string", "maxLength": 32 },
        "order": { "type": "number" },
        "videoStoragePath": { "type": "string", "maxLength": 500 },
        "resourceStoragePath": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "courseId", "moduleId", "title", "order"]
    },
    "Ebook": {
      "title": "Ebook",
      "description": "Digital PDF ebook product priced in NGN.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "description": { "type": "string", "maxLength": 5000 },
        "author": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 64 },
        "priceNGN": { "type": "number" },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "pdfStoragePath": { "type": "string", "maxLength": 500 },
        "published": { "type": "boolean" }
      },
      "required": ["id", "title", "author", "priceNGN", "published"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase order verified server-side via Paystack.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "productType": { "type": "string", "enum": ["course", "ebook"] },
        "productId": { "type": "string", "maxLength": 128 },
        "amountNGN": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "PAID", "FAILED", "REFUND_REQUESTED", "REFUNDED"] },
        "paymentReference": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "reference", "userId", "customerEmail", "productType", "productId", "amountNGN", "status"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Authorized student access to a course or ebook.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "productType": { "type": "string", "enum": ["course", "ebook"] },
        "productId": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId", "productType", "productId", "orderId"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Site-wide editorial announcement.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 140 },
        "message": { "type": "string", "maxLength": 500 },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "message", "active"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Configurable site branding, hero text, and contact settings.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 100 },
        "heroHeadline": { "type": "string", "maxLength": 200 },
        "heroSubheadline": { "type": "string", "maxLength": 500 },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "whatsappNumber": { "type": "string", "maxLength": 32 },
        "businessEmail": { "type": "string", "format": "email", "maxLength": 254 }
      },
      "required": ["siteName", "heroHeadline", "whatsappNumber", "businessEmail"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "User profiles with strict owner/admin PII isolation." },
    "/courses/{courseId}": { "schema": { "$ref": "#/entities/Course" }, "description": "Course marketplace catalog." },
    "/modules/{moduleId}": { "schema": { "$ref": "#/entities/Module" }, "description": "Course curriculum modules." },
    "/lessons/{lessonId}": { "schema": { "$ref": "#/entities/Lesson" }, "description": "Protected lesson records." },
    "/ebooks/{ebookId}": { "schema": { "$ref": "#/entities/Ebook" }, "description": "Digital ebook catalog." },
    "/orders/{orderId}": { "schema": { "$ref": "#/entities/Order" }, "description": "Customer purchase orders." },
    "/enrollments/{enrollmentId}": { "schema": { "$ref": "#/entities/Enrollment" }, "description": "Verified student course and ebook access." },
    "/announcements/{announcementId}": { "schema": { "$ref": "#/entities/Announcement" }, "description": "Platform announcements." },
    "/siteSettings/{settingId}": { "schema": { "$ref": "#/entities/SiteSettings" }, "description": "Global site configuration." }
  }
}
